{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"declaration": true,
		"downlevelIteration": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"importHelpers": false,
		"importsNotUsedAsValues": "remove",
		"jsx": "react-jsx",
		"lib": [
			"dom",
			"DOM.Iterable",
			"ES5",
			"ES2015",
			"ES2016",
			"ES2017",
			"ES2018",
			"ES2019",
			"ES2020",
			"esnext"
		],
		"module": "CommonJS",
		"moduleResolution": "node",
		"newLine": "LF",
		"noEmitHelpers": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"paths": {
			"@integrate/*": [
				"./integrate/src/*"
			],
			"@swc-node/core": [
				"./core/index.ts"
			],
			"@swc-node/register/*": [
				"./register/*"
			]
		},
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"stripInternal": true,
		"target": "ES2018"
	},
	"extends": "@playform/build/tsconfig",
	"files": [],
	"include": [
		"src"
	],
	"references": [
		{
			"path": "./packages/core"
		},
		{
			"path": "./packages/register"
		},
		{
			"path": "./packages/register/tsconfig.esm.json"
		},
		{
			"path": "./packages/jest"
		},
		{
			"path": "./packages/sourcemap-support"
		},
		{
			"path": "./packages/loader"
		}
	]
}
