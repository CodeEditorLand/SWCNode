{
	"compilerOptions": {
		"baseUrl": "./",
		"composite": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"outDir": "Target",
		"paths": {
			"@subdirectory/*": [
				"./src/subdirectory/*"
			]
		},
		"rootDir": "src",
		"target": "ESNext"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"package.json",
		"src",
		"src"
	]
}
